{
  "name": "reuter4",
  "version": "1.0.0",
  "description": "Reuter4: cuatro ejércitos en dos bandos, tablero en 3D y partidas online",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
