    "entrenar": "node entrenamiento/entrenar-pesos.mjs",
    "informe": "node entrenamiento/informe.mjs",
    "revisar": "node entrenamiento/revisar-pesos.mjs",
    "mirar": "node entrenamiento/mirar.mjs",
    "informe-redes": "node entrenamiento/informe-redes.mjs",
